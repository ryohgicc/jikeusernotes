{
  "manifest_version": 3,
  "name": "即刻私人备注",
  "version": "1.2.2",
  "description": "即刻网页版私人备注与信息流阅读位置自动恢复，数据保存在本机。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://web.okjike.com/*"],
    "js": ["content.js", "reading.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://web.okjike.com/*"],
    "js": ["reading-bridge.js"],
    "world": "MAIN",
    "run_at": "document_idle"
  }],
  "action": { "default_title": "即刻私人备注", "default_popup": "popup.html" }
}
